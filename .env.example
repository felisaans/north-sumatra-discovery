APP_NAME="North Sumatra Discovery"
APP_ENV=local
APP_KEY=                       # diisi otomatis oleh: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost       # GANTI DI SINI: sesuaikan, mis. http://north-sumatra-discovery.test (Herd) atau http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (MySQL / MariaDB) ---
DB_CONNECTION=mariadb          # GANTI DI SINI: ganti ke "mysql" bila memakai MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=north_sumatra_discovery     # GANTI DI SINI: nama database lokal (buat dulu database kosong)
DB_USERNAME=root               # GANTI DI SINI
DB_PASSWORD=                   # GANTI DI SINI

# --- Session, cache, & antrean memakai database ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Media beranda (video & poster di-host online, tidak ikut di source code) ---
# Isi dengan URL penuh video .mp4 dari hosting mana saja (Cloudinary, CDN, dsb.), contoh:
#   EDITORIAL_TOR_TOR_VIDEO_URL=https://res.cloudinary.com/NAMA-AKUN/video/upload/tor-tor.mp4
# Kosong = tampil ilustrasi. Rasio frame tiap video diatur di config/video.php (lebar/tinggi).

# --- Tautan sosial media di footer (boleh nama akun atau URL penuh; kosong = disembunyikan) ---

# --- Akun awal untuk "php artisan migrate --seed" (dipakai UserSeeder) ---
SEED_ADMIN_NAME="Admin North Sumatra Discovery"
SEED_ADMIN_EMAIL=admin@nsdiscovery.test   # GANTI DI SINI
SEED_ADMIN_PASSWORD=admin1234             # WAJIB diisi (minimal 8 karakter): sandi akun admin
SEED_USER_EMAIL=user@nsdiscovery.test     # GANTI DI SINI
SEED_USER_PASSWORD=user1234               # WAJIB diisi (minimal 8 karakter): sandi akun pengguna contoh

# --- Email: cukup dicatat ke log (tidak mengirim email sungguhan) ---
MAIL_MAILER=log

# ===== Media & tautan (disalin dari versi hosting; semuanya URL publik) =====
# Kosongkan satu baris untuk kembali ke ilustrasi bawaan. Boleh diganti dengan URL milikmu sendiri.

# HERO
HERO_VIDEO_URL=
HERO_POSTER_URL=

